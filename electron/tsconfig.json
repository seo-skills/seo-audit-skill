{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "paths": {
      "@core/*": ["../src/*"],
      "@renderer/*": ["../ui/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../ui/**/*.ts",
    "../ui/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
