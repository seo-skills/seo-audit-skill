{
  "name": "@seomator/seo-audit",
  "version": "5.0.0",
  "description": "SEOmator - Comprehensive SEO audit CLI tool with 332 rules across 20 categories",
  "type": "module",
  "bin": {
    "seomator": "./dist/cli.js"
  },
  "main": "./dist-electron/main/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:cli && npm run web:build",
    "clean": "node scripts/clean.mjs",
    "build:cli": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "electron:dev": "electron-vite dev -c electron/electron-vite.config.ts",
    "electron:build": "electron-vite build -c electron/electron-vite.config.ts",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3 && node scripts/resign-native.mjs",
    "rebuild:cli": "npm rebuild better-sqlite3 && node scripts/resign-native.mjs",
    "electron:icon": "node scripts/generate-icon.mjs",
    "electron:pack": "electron-builder install-app-deps && npm run electron:build && electron-builder --dir",
    "electron:dist": "electron-builder install-app-deps && npm run electron:build && electron-builder",
    "electron:dist:mac": "electron-builder install-app-deps && npm run electron:build && electron-builder --mac",
    "electron:dist:win": "electron-builder install-app-deps && npm run electron:build && electron-builder --win",
    "prepublishOnly": "npm run typecheck && npm run build && npm run check:docs && npm run check:tokens",
    "sync:docs": "node scripts/sync-docs.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "check:tokens": "node scripts/gen-tokens.mjs --check",
    "check:docs": "node scripts/sync-docs.mjs --check",
    "web:build": "vite build -c vite.web.config.ts",
    "web:dev": "concurrently -n api,web -c blue,green \"node --watch dist/cli.js serve --port 7360 --no-open\" \"vite -c vite.web.config.ts\""
  },
  "keywords": [
    "seo",
    "seo-audit",
    "audit",
    "cli",
    "web-vitals",
    "core-web-vitals",
    "lighthouse",
    "meta-tags",
    "structured-data",
    "accessibility",
    "crawler",
    "site-audit",
    "javascript-rendering",
    "redirect-checker",
    "html-validation",
    "ai-seo",
    "geo",
    "hreflang",
    "eeat",
    "technical-seo"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seo-skills/seo-audit-skill.git"
  },
  "bugs": {
    "url": "https://github.com/seo-skills/seo-audit-skill/issues"
  },
  "homepage": "https://github.com/seo-skills/seo-audit-skill#readme",
  "engines": {
    "node": ">=20.3.0"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "better-sqlite3": "^12.11.1",
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "log-update": "^6.1.0",
    "ora": "^8.1.1",
    "playwright": "^1.49.1",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^10.0.5",
    "domhandler": "^5.0.3",
    "electron": "^40.4.0",
    "electron-builder": "^26.7.0",
    "electron-vite": "^5.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "shadcn": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zustand": "^5.0.11"
  }
}
