{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@core/*": ["../src/*"],
      "@renderer/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../electron/shared/**/*.ts", "../electron/preload/**/*.ts"]
}
